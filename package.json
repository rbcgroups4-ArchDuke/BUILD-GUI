{
  "name": "maist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "powershell -NoProfile -Command \"if (Test-Path .next) { Remove-Item -LiteralPath .next -Recurse -Force }; if (Test-Path .next-dev) { Remove-Item -LiteralPath .next-dev -Recurse -Force }\"",
    "dev": "next dev",
    "dev:3001": "next dev -p 3001",
    "dev:clean": "npm run clean && next dev",
    "dev:clean:3001": "npm run clean && next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "next": "^15.5.6",
    "pino": "^9.0.0",
    "pino-pretty": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
